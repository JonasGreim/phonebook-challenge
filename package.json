{
  "name": "telefonbuch-suche",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" package.json tsconfig.json tsconfig.app.json tsconfig.server.json vite.config.ts eslint.config.js .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" package.json tsconfig.json tsconfig.app.json tsconfig.server.json vite.config.ts eslint.config.js .prettierrc.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "graphql": "^16.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
